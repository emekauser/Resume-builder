enum Role {
  USER
  ADMIN
  MODERATOR
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model Users {
  id              Int      @default(autoincrement())
  userId          String   @unique @default(uuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  CV              Resumes?
  resumesResumeId String?
  firstName       String?  @db.VarChar(255)
  lastName        String?  @db.VarChar(255)

  // email
  email                       String    @unique
  emailVerificationCode       String?
  emailVerificationCreatedAt  DateTime?
  emailVerificationExpiration DateTime?
  emailIsVerify               Boolean?
  emailVerificationDate       DateTime?

  // Password
  password                   String    @db.VarChar(255)
  passwordResetCode          String?
  passwordResetCodeCreatedAt DateTime?
  passwordResetCodeUpdatedAt DateTime?
  passwordResetCodeCount     Int?

  lastSignInAt     DateTime?
  dateOfBirth      DateTime?
  gender           Gender?
  userImage        Bytes?
  banned           Boolean?
  birthday         DateTime?
  phoneNumbers     String?
  hasImage         Boolean?
  twoFactorEnabled Boolean?
  passwordEnabled  Boolean?

  @@map("users")
}
