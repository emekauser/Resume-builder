generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Contacts {
  contactId String @id @default(uuid())
}

model Templates {
  templateId String  @id @default(uuid())
  name       String
  tag        String?

  @@map("templates")
}

model Resumes {
  resumeId            String     @id @default(uuid())
  title               String?
  resumeColor         String     @default("#0000")
  resumeType          String
  professionalSummary String?
  photoURL            String?
  firstName           String?
  lastName            String?
  country             String?
  phone               String?
  email               String
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt // updates this field when we update this entry in the database.
  workHistory         String[]
  guestUserId         String     @unique
  // GuestUsers          GuestUsers @relation(fields: [guestUserId], references: [userId])
  user                Users      @relation(fields: [userID], references: [userId]) // foreign key userID reference primary key in User table which is userId
  userID              String     @unique

  @@map("resumes")
}

enum TEMPLATES_ENUM {
  Prominent
  Strong
  Traditional
  Smart
  Trusted
}

